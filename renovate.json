{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "npm",
    "gomod",
    "github-actions"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "14 days",
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "Etc/UTC",
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "rangeStrategy": "pin",
  "automerge": false,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "routine dependency updates"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
